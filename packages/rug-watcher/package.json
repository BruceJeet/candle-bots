{
  "name": "candle-rug-watcher",
  "version": "0.1.1",
  "description": "Watches the coins a Solana wallet holds and sells (or alerts) when a rule fires: a liquidity pull, a price crash, the creator dumping, a large holder leaving. Candle coins, pump.fun curves and PumpSwap. Built on @candledottv/agent-sdk.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceJeet/candle-bots.git",
    "directory": "packages/rug-watcher"
  },
  "homepage": "https://github.com/BruceJeet/candle-bots/tree/main/packages/rug-watcher#readme",
  "bugs": {
    "url": "https://github.com/BruceJeet/candle-bots/issues"
  },
  "bin": {
    "candle-rug-watcher": "bin/candle-rug-watcher"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "candle-bot-core": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "keywords": [
    "candle",
    "solana",
    "trading-bot",
    "rug",
    "rug-pull",
    "alert",
    "stop-loss",
    "pump.fun",
    "pumpswap",
    "memecoin",
    "bot",
    "agent"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
