{
  "comment": "Dry run: decides and logs, never trades. No API key needed. Put the wallets you copy in leaders.",
  "mode": "dry",
  "payer": "embedded",
  "apiKeyEnv": "CANDLE_API_KEY",
  "rpcUrlEnv": "SOLANA_RPC_URL",
  "wallet": "11111111111111111111111111111111",
  "stateDir": "./state-dry",
  "buy": { "sol": 0.01, "maxSlippageBps": 1000, "maxOpen": 3, "lifetimeSol": 0.1, "maxPerCoin": 1 },
  "sell": { "maxSlippageBps": 1500 },
  "leaders": [{ "address": "11111111111111111111111111111112", "label": "example", "maxEntries": 5 }],
  "mirror": {
    "ticket": { "mode": "fixed" },
    "copy": "opens",
    "maxAgeSec": 20,
    "minLeaderSol": 0.1,
    "sells": true
  },
  "source": { "fetchPerSec": 1 },
  "exit": { "strategy": "tpsl", "takeProfit": 3, "stopLoss": 0.5 }
}
