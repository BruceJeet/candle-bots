{
  "name": "candle-event-bot",
  "version": "0.1.0",
  "description": "Buys coins tied to a dated event in a window before it, and exits them in phases keyed to the event: ride the build-up, hedge at the event, keep a moonshot core. A Solana bot built on @candledottv/agent-sdk.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceJeet/candle-bots.git",
    "directory": "packages/event-bot"
  },
  "homepage": "https://github.com/BruceJeet/candle-bots/tree/main/packages/event-bot#readme",
  "bugs": {
    "url": "https://github.com/BruceJeet/candle-bots/issues"
  },
  "bin": {
    "candle-event-bot": "bin/candle-event-bot"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "candle-bot-core": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "keywords": [
    "candle",
    "solana",
    "trading-bot",
    "event",
    "launch",
    "memecoin",
    "bot",
    "agent"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
