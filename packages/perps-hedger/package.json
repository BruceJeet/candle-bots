{
  "name": "candle-perps-hedger",
  "version": "0.1.0",
  "description": "Hedges the spot bags of a Solana wallet with Hyperliquid perps through Candle: a short on the coin's own perp when Hyperliquid lists it, else on a proxy (SOL), sized by a ratio or a fitted beta; rebalances outside a band, caps leverage and margin, closes reduce-only, books fees and funding. Dry runs on paper. Built on candle-bot-core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceJeet/candle-bots.git",
    "directory": "packages/perps-hedger"
  },
  "homepage": "https://github.com/BruceJeet/candle-bots/tree/main/packages/perps-hedger#readme",
  "bugs": {
    "url": "https://github.com/BruceJeet/candle-bots/issues"
  },
  "bin": {
    "candle-perps-hedger": "bin/candle-perps-hedger"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "candle-bot-core": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "keywords": [
    "candle",
    "solana",
    "hyperliquid",
    "perps",
    "hedge",
    "funding",
    "pump.fun",
    "pumpswap",
    "memecoin",
    "bot",
    "agent"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
