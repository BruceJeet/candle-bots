{
  "name": "candle-scanner-bot",
  "version": "0.1.0",
  "description": "Watches pump.fun and PumpSwap coins (a list, or a Candle feed bucket) and alerts on Telegram, Discord or a webhook when a rule fires: a volume spike, a dip, a breakout, a hot 5 m on the feed. Watch-only: no wallet, no key, never trades. Built on candle-bot-core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceJeet/candle-bots.git",
    "directory": "packages/scanner-bot"
  },
  "homepage": "https://github.com/BruceJeet/candle-bots/tree/main/packages/scanner-bot#readme",
  "bugs": {
    "url": "https://github.com/BruceJeet/candle-bots/issues"
  },
  "bin": {
    "candle-scanner-bot": "bin/candle-scanner-bot"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "candle-bot-core": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "keywords": [
    "candle",
    "solana",
    "scanner",
    "alerts",
    "telegram",
    "discord",
    "volume",
    "pump.fun",
    "pumpswap",
    "memecoin",
    "bot"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
