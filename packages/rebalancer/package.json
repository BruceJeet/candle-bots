{
  "name": "candle-rebalancer",
  "version": "0.1.0",
  "description": "Holds a Solana wallet at target weights across coins and SOL: on a schedule it sells what is over its band, then buys what is under, with a minimum trade size and a cap on SOL moved per run. Candle coins, pump.fun curves and PumpSwap. Built on @candledottv/agent-sdk.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceJeet/candle-bots.git",
    "directory": "packages/rebalancer"
  },
  "homepage": "https://github.com/BruceJeet/candle-bots/tree/main/packages/rebalancer#readme",
  "bugs": {
    "url": "https://github.com/BruceJeet/candle-bots/issues"
  },
  "bin": {
    "candle-rebalancer": "bin/candle-rebalancer"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "candle-bot-core": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "keywords": [
    "candle",
    "solana",
    "trading-bot",
    "rebalance",
    "portfolio",
    "weights",
    "pump.fun",
    "pumpswap",
    "memecoin",
    "bot",
    "agent"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
